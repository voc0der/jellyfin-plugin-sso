## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
artifacts/

# Visual Studio cache/options
.vs/

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet Packages
*.nupkg
**/packages/*

# Build results
*.dll
*.exe
*.pdb

# Test harness output
node_modules/
tests/e2e/.build/
tests/e2e/test-results/
tests/e2e/playwright-report/
TestResults/
