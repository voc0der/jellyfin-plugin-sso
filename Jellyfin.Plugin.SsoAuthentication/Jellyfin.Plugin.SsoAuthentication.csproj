<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.SsoAuthentication</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Config\configPage.html" />
    <EmbeddedResource Include="Config\config.js" />
    <EmbeddedResource Include="Config\style.css" />
    <EmbeddedResource Include="Config\linking.html" />
    <EmbeddedResource Include="Config\linking.js" />
    <EmbeddedResource Include="Views\apiClient.js" />
    <EmbeddedResource Include="Views\jellyfin-apiClient.esm.min.js" />
    <EmbeddedResource Include="Views\emby-restyle.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.SsoAuthentication.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Shipped in the plugin archive: Jellyfin does not provide these. -->
  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
  </ItemGroup>

  <!-- Compile-time only. The server owns these assemblies, and a second copy in the
       plugin directory would give the plugin its own copy of types the server owns.
       Newtonsoft.Json is not referenced by Jellyfin's packages, but every Jellyfin
       server ships it (13.0.4 in both 10.11 and 12), which is what the OpenID role
       claim parsing has always relied on. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <!-- meta.json is what Jellyfin reads when the plugin is installed by hand, and what
       build.sh packages. Generating it from the same properties that drive the assembly
       version and the package references means the manifest, the packages compiled
       against, and the ABI cannot drift apart. Jellyfin installs into
       plugins/<name>_<version>, so once released the name is a path, as is the assembly
       name, which names the settings file: neither changes after that. -->
  <Target Name="GeneratePluginManifest" AfterTargets="Build;Publish">
    <ItemGroup>
      <PluginManifestLine Include="{" />
      <PluginManifestLine Include="  &quot;guid&quot;: &quot;$(PluginGuid)&quot;," />
      <PluginManifestLine Include="  &quot;name&quot;: &quot;SSO Authentication&quot;," />
      <PluginManifestLine Include="  &quot;overview&quot;: &quot;Sign in to Jellyfin with OpenID Connect or SAML&quot;," />
      <PluginManifestLine Include="  &quot;description&quot;: &quot;Lets users sign in to Jellyfin through an OpenID Connect or SAML identity provider such as Authelia, authentik, Keycloak, Pocket ID or Kanidm. Accounts are created on first sign-in, and the provider&apos;s roles can decide who may sign in, who is an administrator, and which libraries and Live TV each account can use. Continues 9p4&apos;s SSO-Auth plugin under its own ID: remove that plugin first, and this one picks up its providers and linked accounts.&quot;," />
      <PluginManifestLine Include="  &quot;owner&quot;: &quot;$(Authors)&quot;," />
      <PluginManifestLine Include="  &quot;category&quot;: &quot;Authentication&quot;," />
      <PluginManifestLine Include="  &quot;version&quot;: &quot;$(Version)&quot;," />
      <PluginManifestLine Include="  &quot;targetAbi&quot;: &quot;$(JellyfinTargetAbi)&quot;," />
      <PluginManifestLine Include="  &quot;framework&quot;: &quot;$(TargetFramework)&quot;," />
      <PluginManifestLine Include="  &quot;status&quot;: &quot;Active&quot;," />
      <PluginManifestLine Include="  &quot;autoUpdate&quot;: false," />
      <PluginManifestLine Include="  &quot;imagePath&quot;: &quot;&quot;" />
      <PluginManifestLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(OutputPath)meta.json"
                      Lines="@(PluginManifestLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <WriteLinesToFile File="$(PublishDir)meta.json"
                      Lines="@(PluginManifestLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
